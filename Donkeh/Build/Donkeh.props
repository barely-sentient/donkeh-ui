<Project>

    <!--
        Donkeh target opt-in.

        A consumer chooses the hosts it wants:

            <DonkehDesktop>true</DonkehDesktop>
            <DonkehAndroid>true</DonkehAndroid>
            <DonkehWeb>true</DonkehWeb>

        The framework adds the matching target frameworks and references. Only
        Desktop is on by default so an existing app keeps compiling unchanged.
    -->
    <PropertyGroup>
        <DonkehDesktop Condition="'$(DonkehDesktop)' == ''">true</DonkehDesktop>
        <DonkehAndroid Condition="'$(DonkehAndroid)' == ''">false</DonkehAndroid>
        <DonkehWeb Condition="'$(DonkehWeb)' == ''">false</DonkehWeb>
    </PropertyGroup>

    <PropertyGroup>
        <!--
            Build the target list with plain properties. Joining them through a
            property function such as String.Copy(...).Trim(';') escapes the
            separator, so the SDK sees one target named "net10.0;net10.0-android"
            and multi-targeting fails with NETSDK1046.
        -->
        <DonkehTargetFrameworks></DonkehTargetFrameworks>
        <DonkehTargetFrameworks Condition="'$(DonkehDesktop)' == 'true'">net10.0</DonkehTargetFrameworks>
        <DonkehTargetFrameworks Condition="'$(DonkehAndroid)' == 'true' and '$(DonkehTargetFrameworks)' != ''">$(DonkehTargetFrameworks);net10.0-android</DonkehTargetFrameworks>
        <DonkehTargetFrameworks Condition="'$(DonkehAndroid)' == 'true' and '$(DonkehTargetFrameworks)' == ''">net10.0-android</DonkehTargetFrameworks>
        <DonkehTargetFrameworks Condition="'$(DonkehWeb)' == 'true' and '$(DonkehTargetFrameworks)' != ''">$(DonkehTargetFrameworks);net10.0-browser</DonkehTargetFrameworks>
        <DonkehTargetFrameworks Condition="'$(DonkehWeb)' == 'true' and '$(DonkehTargetFrameworks)' == ''">net10.0-browser</DonkehTargetFrameworks>
        <!-- Restore needs the browser RID in the outer build; inner Android builds
             keep the Android SDK's own ABI list. -->
        <RuntimeIdentifiers Condition="'$(DonkehWeb)' == 'true' and '$(TargetFramework)' == ''">browser-wasm;android-arm64;android-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="'$(DonkehWeb)' == 'true' and '$(TargetFramework)' == 'net10.0-browser'">browser-wasm</RuntimeIdentifiers>

        <!-- Semicolon-separated Android permission tokens, for example
             Camera;Microphone;Location;Notifications. -->
        <DonkehAndroidPermissions Condition="'$(DonkehAndroidPermissions)' == ''"></DonkehAndroidPermissions>
    </PropertyGroup>

    <!--
        The WebAssembly pack is normally discovered through NuGet's generated
        props, which run before the target framework is known. Point the SDK at
        the browser pack explicitly so its props are imported for this inner
        build.
    -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browser' and '$(PkgMicrosoft_NET_Sdk_WebAssembly_Pack)' != ''">
        <_WebAssemblyPropsFile>$(PkgMicrosoft_NET_Sdk_WebAssembly_Pack)\build\Microsoft.NET.Sdk.WebAssembly.Browser.props</_WebAssemblyPropsFile>
    </PropertyGroup>

    <Import Sdk="Microsoft.NET.Sdk.BlazorWebAssembly"
            Project="Sdk.props"
            Condition="'$(TargetFramework)' == 'net10.0-browser'" />

</Project>
