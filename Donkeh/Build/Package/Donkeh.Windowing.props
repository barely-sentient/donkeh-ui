<Project>

    <PropertyGroup>
        <!--
            INTERNET permission for external assets (remote @import rules, fonts
            and url(...) images in the app's stylesheets).

            auto   detect remote URLs in the app's CSS and declare the permission
            true   always declare it
            false  never declare it (offline app)
        -->
        <DonkehAndroidInternet Condition="'$(DonkehAndroidInternet)' == ''">auto</DonkehAndroidInternet>
    </PropertyGroup>

    <!--
        Browser builds need the Blazor WebAssembly SDK props. The generated
        project only sets TargetFrameworks, so the package adds the SDK pieces
        when the browser target is enabled.
    -->
    <Import Sdk="Microsoft.NET.Sdk.BlazorWebAssembly"
            Project="Sdk.props"
            Condition="'$(TargetFramework)' == 'net10.0-browser'" />

    <!--
        CefSharp's buildTransitive targets copy the CEF redistributables (locale
        .pak files plus CefSharp.dll/Ijwhost.dll for the browser subprocess).
        They only run for projects that reference the package directly, so a
        ProjectReference/PackageReference to Donkeh.Windowing alone leaves the
        desktop output unbootable. Reference CefSharp from the app as well;
        application code still only sees the engine-neutral WebView controller.
    -->
    <ItemGroup Condition="'$(DonkehDesktop)' != 'false' and ('$(TargetFramework)' == '' or '$(TargetFramework)' == 'net10.0')">
        <PackageReference Include="CefSharp.OffScreen.NETCore" Version="134.3.90" />
    </ItemGroup>

</Project>
