<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Donkeh.Windowing</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <TieredPGO>true</TieredPGO>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="LibVLCSharp" Version="3.10.2" />
      <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
      <PackageReference Include="SoundFlow" Version="1.4.2" />
      <PackageReference Include="StbImageSharp" Version="2.30.16" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    </ItemGroup>

    <ItemGroup>
      <!--
          NuGet consumers get the framework-owned entry point, browser host
          defaults and Android permission wiring without importing the checkout.
      -->
      <None Include="..\..\Build\Package\Donkeh.Windowing.props"
            Pack="true"
            PackagePath="buildTransitive\Donkeh.Windowing.props" />
      <None Include="..\..\Build\Package\Donkeh.Windowing.targets"
            Pack="true"
            PackagePath="buildTransitive\Donkeh.Windowing.targets" />
      <None Include="..\..\Build\Package\index.html"
            Pack="true"
            PackagePath="buildTransitive\Donkeh.Windowing\index.html" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Hosting\Source\Donkeh.Hosting.csproj" />
      <ProjectReference Include="..\..\Data\Source\Data.csproj" />
      <ProjectReference Include="..\..\DataEngine\Source\DataEngine.csproj" />
      <ProjectReference Include="..\..\Parser\Source\Donkeh.Parser.csproj" />
      <ProjectReference Include="..\..\LayoutLab\Source\LayoutLab.csproj" />
      <ProjectReference Include="..\..\UILab\Source\Donkeh.UILab.csproj" />
      <ProjectReference Include="..\..\Inspector\Source\Inspector.csproj" />
    </ItemGroup>

</Project>
