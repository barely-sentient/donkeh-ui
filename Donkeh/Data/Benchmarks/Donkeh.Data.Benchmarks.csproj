<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Donkeh.Data.Benchmarks</RootNamespace>
        <IsPackable>false</IsPackable>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Source\Data.csproj" />
        <ProjectReference Include="..\..\DataEngine\Source\DataEngine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The CDN build of Bootstrap, vendored so runs are reproducible offline.
             BootstrapCss falls back to downloading the same URL when it is absent. -->
        <Content Include="bootstrap.min.css" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
