      <PackageReference Include="StbImageSharp" Version="2.30.16" />
      <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Data\Source\Data.csproj" />
      <ProjectReference Include="..\..\DataEngine\Source\DataEngine.csproj" />
      <ProjectReference Include="..\..\Parser\Source\Ignite.Parser.csproj" />
      <ProjectReference Include="..\..\LayoutLab\Source\LayoutLab.csproj" />
      <ProjectReference Include="..\..\UILab\Source\Ignite.UILab.csproj" />
      <ProjectReference Include="..\..\Inspector\Source\Inspector.csproj" />
    </ItemGroup>

</Project>
